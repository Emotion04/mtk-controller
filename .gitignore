# Build outputs
*.apk
*.idsig

# Keep gradle-wrapper.jar: `./gradlew` cannot run on a fresh clone without it.
# Other jars are third-party tooling and stay out.
*.jar
!mtk-optimizer/gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Reference material — a third party's files, kept local only.
#
# Everything under reference/ is either someone else's file or derived from
# someone else's binary. Only the README is tracked: it explains the folder and
# the rule. See docs/handoff.md.
/reference/*
!/reference/README.md

# Android build artifacts (mtk-optimizer sub-project handles its own)
*.iml
.gradle
.kotlin
build/
captures/
local.properties

# IDE / OS junk
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
.cursor/

# Claude Code
.claude/

# NOTE: every rule above that names a directory is anchored with a leading
# slash for a reason. A bare `src/` also matches `mtk-optimizer/app/src/`, which
# silently keeps the app's own new source files out of the repository while the
# already-tracked ones keep working — so the mistake is invisible until someone
# clones fresh.

# Cloud-sync client temp files. These appear next to a file while it uploads and
# have twice ended up staged — they are not part of the project.
*.uploading.*
*.baiduyun.*
*.onedrive.*
*.dropbox.*
desktop.ini
